APP_NAME=Telecom FAQ Semantic Search API
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://telecom_app:change-me-before-run@localhost:5432/telecom_faq
FRONTEND_ORIGIN=http://localhost:3000
EMBEDDING_BACKEND=transformers
EMBEDDING_MODEL_NAME=EuroBERT/EuroBERT-210m
EMBEDDING_DIM=768
SIMILARITY_THRESHOLD=0.72
FALLBACK_MESSAGE=Точный ответ не найден. Мы передали запрос оператору поддержки.
SEED_FAQ_PATH=../data/faqs.json
